<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" >

    <data>
        <import type="android.view.View" />
        <import type="com.example.composefirsttry.giftcard.model.GiftCard" />
        <variable name="store" type="com.example.composefirsttry.giftcard.model.Store"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/store_name"
            android:layout_width="128dp"
            android:layout_height="72dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/black"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/store_frame"
            android:text="@{store.storeName}"
            tools:text="Mega Sport"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/store_name"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.15"
            />

        <include
            android:id="@+id/card_max"
            android:layout_width="60dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@id/guideline"
            app:layout_constraintStart_toEndOf="@id/store_name"
            android:layout_marginStart="8dp"
            layout="@layout/gift_card_small_layout"
            app:cardNameSmallLayout="@{GiftCard.MAX_CARD_NAME}"
            app:cardImageSmallLayout="@{@drawable/max}"
            android:visibility="@{store.maxCard ? View.VISIBLE : View.GONE, default=invisible}"
            tools:visibility="visible"
            />

        <include
            android:id="@+id/card_corporate"
            android:layout_width="60dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@id/card_max"
            app:layout_constraintTop_toTopOf="@id/guideline"
            android:layout_marginStart="8dp"
            layout="@layout/gift_card_small_layout"
            app:cardNameSmallLayout="@{GiftCard.CORPORATE_CARD_NAME}"
            app:cardImageSmallLayout="@{@drawable/corporate}"
            android:visibility="@{store.corporateCard ? View.VISIBLE : View.GONE, default=invisible}"
            tools:visibility="visible"
            />
<!--        app:cardName="@{giftCardCorporate.name}"-->

        <include
            android:id="@+id/card_hot"
            android:layout_width="60dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toEndOf="@id/card_corporate"
            app:layout_constraintTop_toTopOf="@id/guideline"
            android:layout_marginStart="8dp"
            layout="@layout/gift_card_small_layout"
            app:cardNameSmallLayout="@{GiftCard.HOT_CARD_NAME}"
            app:cardImageSmallLayout="@{@drawable/hot}"
            android:visibility="@{store.hotCard ? View.VISIBLE : View.GONE, default=invisible}"
            tools:visibility="visible"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
