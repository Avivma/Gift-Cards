<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="card"
            type="com.example.composefirsttry.giftcard.logic.cards.model.GiftCardExtended" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_details_background"
        android:paddingBottom="16dp"
        >
        <ImageView
            android:id="@+id/card_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp"
            android:layout_width="200dp"
            android:layout_height="120dp"
            tools:src="@drawable/max"
            app:loadImage="@{card.imageRes}"
            />

        <LinearLayout
            android:id="@+id/name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/card_image"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsLabelStyle"
                android:text="Name"
                />
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:autoSizeMinTextSize="12sp"
                style="@style/cardDetailsValueStyle"
                android:text="@{card.name}"
                tools:text="Max"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/discount_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/name_layout"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsLabelStyle"
                android:text="Discount"
                />
            <TextView
                android:id="@+id/discount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsValueStyle"
                app:setDiscount="@{card.discount}"
                tools:text="16.5%"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/number_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/discount_layout"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsLabelStyle"
                android:text="Card Number"
                />
            <TextView
                android:id="@+id/number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:autoSizeMinTextSize="12sp"
                style="@style/cardDetailsValueStyle"
                android:text="@{card.number}"
                tools:text="1111-1111-1111-111"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expiration_date_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/number_layout"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsLabelStyle"
                android:text="Expiration Date"
                />
            <TextView
                android:id="@+id/expiration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:autoSizeMinTextSize="12sp"
                style="@style/cardDetailsValueStyle"
                android:text="@{card.expirationDate}"
                tools:text="01/26"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cvv_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/expiration_date_layout"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsLabelStyle"
                android:text="CVV"
                />
            <TextView
                android:id="@+id/cvv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/cardDetailsValueStyle"
                android:text="@{card.cvv}"
                tools:text="999"
                />
        </LinearLayout>
        <ImageButton
            android:id="@+id/load_money_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/edit_button"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_load_money"
            android:background="@drawable/store_frame"
            android:scaleType="centerInside"
            />

        <ImageButton
            android:id="@+id/edit_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toStartOf="@id/load_money_button"
            app:layout_constraintStart_toEndOf="@id/remove_button"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_edit"
            android:background="@drawable/store_frame"
            android:scaleType="centerInside"
            />

        <ImageButton
            android:id="@+id/remove_button"
            android:layout_width="0dp"
            android:layout_height="36dp"
            app:layout_constraintEnd_toStartOf="@id/edit_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_remove_all_favorites"
            android:background="@drawable/store_frame"
            android:scaleType="centerInside"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>