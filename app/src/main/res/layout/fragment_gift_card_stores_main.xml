<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.example.composefirsttry.giftcard.model.GiftCard" />
        <variable
            name="model"
            type="com.example.composefirsttry.giftcard.viewmodel.StoresMainViewModel"
            />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/store_recycler_view"
            android:layout_marginBottom="4dp"
            android:background="@color/top_background"
            />

        <TextView
            android:id="@+id/stores_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Stores"
            android:textSize="24sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/search_store"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:paddingStart="20dp"
            android:paddingEnd="40dp"
            android:hint="Search store..."
            android:textColorHint="@color/grey"
            android:text="@={model.searchTextMutableLiveData}"
            android:textSize="20sp"
            android:background="@drawable/search_edit_box_frame"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stores_title" />
        <View
            android:id="@+id/search_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:layout_constraintTop_toTopOf="@id/search_store"
            app:layout_constraintBottom_toBottomOf="@id/search_store"
            app:layout_constraintEnd_toEndOf="@id/search_store"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_search"
            />

        <include
            android:id="@+id/max_check_box"
            layout="@layout/gift_card_with_frame_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/corporate_check_box"
            app:layout_constraintTop_toBottomOf="@id/search_store"
            app:cardCheckedLayoutWithFrame="@{model.maxCardChecked}"
            app:cardNameLayoutWithFrame="@{GiftCard.MAX_CARD_NAME}"
            app:cardImageLayoutWithFrame="@{@drawable/max}"
            />

        <include
            android:id="@+id/corporate_check_box"
            layout="@layout/gift_card_with_frame_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintStart_toEndOf="@id/max_check_box"
            app:layout_constraintEnd_toStartOf="@+id/hot_check_box"
            app:layout_constraintTop_toTopOf="@id/max_check_box"
            app:cardCheckedLayoutWithFrame="@{model.corporateCardChecked}"
            app:cardNameLayoutWithFrame="@{GiftCard.CORPORATE_CARD_NAME}"
            app:cardImageLayoutWithFrame="@{@drawable/corporate}"
            />

        <include
            android:id="@+id/hot_check_box"
            layout="@layout/gift_card_with_frame_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintStart_toEndOf="@id/corporate_check_box"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/max_check_box"
            app:cardCheckedLayoutWithFrame="@{model.hotCardChecked}"
            app:cardNameLayoutWithFrame="@{GiftCard.HOT_CARD_NAME}"
            app:cardImageLayoutWithFrame="@{@drawable/hot}"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/store_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/max_check_box"
            tools:itemCount="5"
            tools:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/store_row_layout"
            tools:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/progress_circular"
            android:layout_width="120dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@id/store_recycler_view"
            app:layout_constraintBottom_toBottomOf="@id/store_recycler_view"
            app:layout_constraintStart_toStartOf="@id/store_recycler_view"
            app:layout_constraintEnd_toEndOf="@id/store_recycler_view"
            android:visibility="gone"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>