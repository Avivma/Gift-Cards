<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="showClearAll" type="java.lang.Boolean"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".giftcard.ui.cards.CardsFragment">
        <!--    android:background="@drawable/navigation_menu_background"-->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/card_details_layout"
            tools:itemCount="3"
            />

        <ImageButton
            android:id="@+id/clear_all"
            android:layout_width="60dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:padding="10dp"
            android:src="@drawable/ic_clear_all"
            android:background="@color/transparent"
            android:scaleType="fitXY"
            android:visibility="@{showClearAll ? View.VISIBLE : View.GONE, default=visible}"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>

